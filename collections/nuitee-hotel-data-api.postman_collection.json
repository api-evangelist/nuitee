  "info": {
    "_postman_id": "3ec58cec-0526-4aac-8975-d3a20187038b",
    "name": "LiteAPI (Nuitée) Hotel Booking Hotel Data API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "LiteAPI by Nuitée is a unified hotel-booking and distribution API. It provides static hotel content and reference data, real-time rates and availability, the prebook/book/retrieve/cancel reservation flow, and loyalty and voucher management over 2M+ properties. All requests are authenticated with an X-API-Key header; a free sandbox key is available.\n\nContact Support:\n Name: LiteAPI Support",
      "type": "text/plain"
    }
  }
